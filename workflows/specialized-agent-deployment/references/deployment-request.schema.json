{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow-hub.local/specialized-agent-deployment/deployment-request.schema.json",
  "title": "Specialized Agent Deployment Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deployment_id",
    "agent_id",
    "display_name",
    "purpose",
    "host",
    "mode",
    "primary_workflow",
    "related_workflows",
    "auxiliary_skills",
    "workdir",
    "config_refs",
    "host_options"
  ],
  "properties": {
    "runtime": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "python", "wheelhouse", "destination"],
          "properties": {
            "mode": {"const": "system-source"},
            "python": {"type": "string", "minLength": 1},
            "wheelhouse": {"type": "string", "minLength": 1},
            "destination": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["python", "wheelhouse", "destination"],
          "properties": {
            "mode": {"const": "isolated"},
            "python": {"type": "string", "minLength": 1},
            "wheelhouse": {"type": "string", "minLength": 1},
            "destination": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "deployment_id": {
      "$ref": "#/$defs/kebab"
    },
    "agent_id": {
      "$ref": "#/$defs/kebab"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "enum": [
        "hermes",
        "deepseek-harness"
      ]
    },
    "mode": {
      "enum": [
        "create",
        "update"
      ]
    },
    "primary_workflow": {
      "$ref": "#/$defs/kebab"
    },
    "related_workflows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skillSelection"
      }
    },
    "auxiliary_skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skillSelection"
      }
    },
    "workdir": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute host work directory."
    },
    "config_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "host_options": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "host": {
            "const": "hermes"
          }
        }
      },
      "then": {
        "properties": {
          "host_options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enablement": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/hermesEnablement"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "mode"
                    ],
                    "properties": {
                      "mode": {
                        "const": "none"
                      }
                    }
                  }
                ]
              },
              "mcp_servers": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/dshMcpServer"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "host": {
            "const": "deepseek-harness"
          }
        }
      },
      "then": {
        "properties": {
          "host_options": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dsh_home",
              "runtime_root",
              "profile"
            ],
            "properties": {
              "dsh_home": {
                "type": "string",
                "minLength": 1
              },
              "runtime_root": {
                "type": "string",
                "minLength": 1
              },
              "profile": {
                "const": "web"
              },
              "mcp_servers": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/dshMcpServer"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "dshMcpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "server_name",
        "command",
        "args",
        "cwd"
      ],
      "properties": {
        "workflow": {
          "$ref": "#/$defs/kebab"
        },
        "server_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "已准备好的服务启动程序绝对路径，不是 shell 字符串。"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "所属工作流规定的 argv；仅使用配置路径，不包含凭据值。"
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "description": "服务的既有工作目录绝对路径。"
        }
      }
    },
    "kebab": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "hermesEnablement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "source_profile",
        "model_strategy",
        "env_strategy",
        "platforms",
        "gateway_strategy",
        "external_resources",
        "behavior_check"
      ],
      "properties": {
        "mode": {
          "const": "full"
        },
        "source_profile": {
          "const": "active"
        },
        "model_strategy": {
          "const": "managed-fields"
        },
        "env_strategy": {
          "const": "full"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$"
          }
        },
        "gateway_strategy": {
          "const": "multiplex-routes"
        },
        "external_resources": {
          "const": "check_only"
        },
        "behavior_check": {
          "const": "readiness_only"
        }
      }
    },
    "skillSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source_kind",
        "source",
        "reason"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/kebab"
        },
        "source_kind": {
          "enum": [
            "hub-workflow",
            "external-skill"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
