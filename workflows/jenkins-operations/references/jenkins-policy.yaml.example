# 此文件只定义 Jenkins 操作范围，绝不保存用户名、Token 或密码。
# confirm_writes 是 INI 层配置（省略即启用；显式 false 时独立能力直接执行受控写），不在此定义。
version: 1

rules:
  # scope.controller 不是 Job 路径；配合 controller 读取权限查看版本和运行状态。
  - name: read-local-controller
    action: read
    controllers: [local]
    environments: [nonproduction]
    path_prefixes: [scope.controller]
    read_scopes: [controller]

  # scope.root 不是 Job 路径；配合 root_list 列举根目录 Item。
  - name: list-local-root
    action: read
    controllers: [local]
    environments: [nonproduction]
    path_prefixes: [scope.root]
    read_scopes: [root_list]

  # scope.nodes 只允许读取节点的最小状态摘要，不会返回节点配置、路径、监控明细或凭据。
  - name: read-local-node-summary
    action: read
    controllers: [local]
    environments: [nonproduction]
    path_prefixes: [scope.nodes]
    read_scopes: [nodes]

  # path_prefixes 限制普通 Item 读取只能落在 projects/ 下。
  - name: read-project-items
    action: read
    controllers: [local]
    environments: [nonproduction]
    path_prefixes: [projects]

# 非生产创建示例。expires_at 到期后自动失效；取消注释前核对 Controller、路径和模板。
