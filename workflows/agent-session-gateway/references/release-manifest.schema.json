{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow-hub.local/agent-session-gateway/release-manifest.schema.json",
  "title": "Lingxi signed release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "board", "version", "anti_rollback", "expires_at", "artifacts", "key_id", "signature"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "release_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "board": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "version": {"type": "string", "minLength": 3, "maxLength": 64},
    "anti_rollback": {"type": "integer", "minimum": 0},
    "expires_at": {"type": "string", "format": "date-time"},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/artifact"}},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "signature": {"type": "string", "minLength": 80, "maxLength": 128}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "size_bytes", "sha256"],
      "properties": {
        "kind": {"enum": ["firmware", "assets"]},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
