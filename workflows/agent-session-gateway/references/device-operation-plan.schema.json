{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow-hub.local/agent-session-gateway/device-operation-plan.schema.json",
  "title": "Lingxi maintenance operation preview",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "device_id", "connection_generation", "release_id", "board", "version", "anti_rollback", "artifacts", "executable", "blockers", "plan_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "connection_generation": {"type": "string", "minLength": 1, "maxLength": 128},
    "release_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "board": {"type": "string", "minLength": 1, "maxLength": 128},
    "version": {"type": "string", "minLength": 3, "maxLength": 64},
    "anti_rollback": {"type": "integer", "minimum": 0},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "release-manifest.schema.json#/$defs/artifact"}},
    "executable": {"const": false},
    "blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "maxLength": 128}},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
