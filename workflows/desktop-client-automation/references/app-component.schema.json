{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-workflow-hub/desktop-client-automation/app-component.schema.json",
  "title": "Windows desktop reusable application component",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "platform", "app_id", "id", "version", "effect",
    "timeout_seconds", "parameters", "implementations", "postcondition"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "platform": {"const": "windows"},
    "app_id": {"$ref": "#/$defs/identifier"},
    "id": {"$ref": "#/$defs/identifier"},
    "version": {"type": "integer", "minimum": 1},
    "effect": {"$ref": "#/$defs/effect"},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "parameters": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "precondition": {"$ref": "#/$defs/assertion"},
    "already_complete": {"$ref": "#/$defs/assertion"},
    "implementations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows-airtest"],
      "properties": {
        "windows-airtest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["steps"],
          "properties": {
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/step"}
            }
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "postcondition"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        },
        "postcondition": {"$ref": "#/$defs/assertion"}
      }
    },
    "postcondition": {"$ref": "#/$defs/assertion"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "effect": {
      "enum": ["none", "read", "idempotent", "create", "submit", "send", "delete", "unknown"]
    },
    "relativeImage": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[/\\\\]|/)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+\\.(?:png|jpg|jpeg)$"
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "template"],
      "properties": {
        "kind": {"const": "image-visible"},
        "template": {"$ref": "#/$defs/relativeImage"},
        "threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "stable_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {
          "enum": [
            "click-image", "double-click-image", "right-click-image",
            "click-coordinate", "type-text", "press-key", "hotkey", "scroll",
            "drag-image", "wait-image", "copy-text", "paste-text"
          ]
        },
        "effect": {"$ref": "#/$defs/effect"},
        "optional": {"type": "boolean"},
        "retries": {"type": "integer", "minimum": 0, "maximum": 5},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "template": {"$ref": "#/$defs/relativeImage"},
        "threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "text": {"type": "string"},
        "key": {"type": "string", "minLength": 1},
        "keys": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "direction": {"enum": ["up", "down"]},
        "amount": {"type": "integer", "minimum": 1, "maximum": 100},
        "from_template": {"$ref": "#/$defs/relativeImage"},
        "to_template": {"$ref": "#/$defs/relativeImage"},
        "description": {"type": "string", "minLength": 1}
      }
    }
  }
}
