{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-workflow-hub/desktop-client-automation/app-composition-request.schema.json",
  "title": "Windows desktop application composition request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "scenario", "catalog_root", "source_surface",
    "target_platform", "apps", "success_assertion", "decision",
    "effective_path_confirmed"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scenario": {"type": "string", "minLength": 1},
    "catalog_root": {"type": "string", "minLength": 1},
    "source_surface": {
      "enum": ["codex-desktop-native-windows-computer-use", "cua-driver-mcp"]
    },
    "target_platform": {"const": "windows"},
    "apps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/app"}
    },
    "success_assertion": {"$ref": "#/$defs/assertion"},
    "decision": {"enum": ["generate-only", "generate-and-replay"]},
    "effective_path_confirmed": {"const": true}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "target_kind", "lifecycle"],
      "properties": {
        "alias": {"$ref": "#/$defs/identifier"},
        "target_kind": {"enum": ["application", "system-dialog", "desktop"]},
        "lifecycle": {"enum": ["restart", "reuse", "attach-only"]},
        "display_id": {"type": ["string", "null"]},
        "executable": {"type": ["string", "null"]},
        "launch_executable": {"type": ["string", "null"]},
        "window_process_executable": {"type": ["string", "null"]},
        "launch_args": {"type": "array", "items": {"type": "string"}},
        "window_title_regex": {"type": ["string", "null"]},
        "startup_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "shutdown_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "force_terminate": {"type": "boolean"}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "template"],
      "properties": {
        "app": {"$ref": "#/$defs/identifier"},
        "template": {"type": "string", "minLength": 1},
        "threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "stable_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
